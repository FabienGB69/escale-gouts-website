# Copier ce fichier en .env et remplir les valeurs

# Resend API — https://resend.com/api-keys
# Nécessaire pour le formulaire de contact (/api/contact)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion API — https://www.notion.so/my-integrations
# Nécessaire pour la route /api/avis (stockage des avis)
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=your_notion_database_id_here

# Cloudflare Turnstile (anti-bot)
PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
